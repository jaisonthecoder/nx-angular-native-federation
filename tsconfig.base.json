{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "incremental": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": [
      "ES2022",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@angola-platform/shared/ui-components": [
        "libs/shared/ui-components/src/index.ts"
      ],
      "@angola-platform/shared/data-access": [
        "libs/shared/data-access/src/index.ts"
      ],
      "@angola-platform/shared/models": [
        "libs/shared/models/src/index.ts"
      ],
      "@angola-workspace/shared/ui-components": [
        "libs/shared/ui-components/src/index.ts"
      ],
      "@angola-workspace/shared/data-access": [
        "libs/shared/data-access/src/index.ts"
      ],
      "@angola-workspace/shared/models": [
        "libs/shared/models/src/index.ts"
      ],
      "@angola-workspace/shared/auth": [
        "libs/shared/auth/src/index.ts"
      ],
      "@angola-workspace/demo-ui-component/*": [
        "apps/micro-apps/demo-ui-component/src/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}